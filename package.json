{
  "name": "votebot",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run db:generate && tsc",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "backup:check": "node ./scripts/backup.cjs --check",
    "backup": "node ./scripts/backup.cjs --backup",
    "backup:verify": "node ./scripts/backup.cjs --verify",
    "backup:decrypt": "node ./scripts/backup-crypto.cjs decrypt",
    "lint": "eslint .",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.cjs",
    "commands": "npm run build && node ./dist/deploy-commands.js",
    "start": "node ./dist/index.js",
    "dev": "npm run build && node ./dist/index.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "discord.js": "14.26.4",
    "media-downloader-ez": "^2.1.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.5.0",
    "prisma": "7.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
