# Copy to .env for local development. Never commit real credentials.
# Existing process environment variables take precedence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional direct PostgreSQL endpoint for migrations (if DATABASE_URL is pooled):
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Tracking, settlement, reports, and warnings are OFF by default.
# Enable only after migrations, command registration, and deployment checks.
REPUTATION_TRACKING_ENABLED=false
# Required when tracking is explicitly enabled; only this server will be tracked.
# REPUTATION_GUILD_ID=YOUR_DISCORD_SERVER_ID

# Backups run separately (local machine / GitHub Actions), not inside the bot.
# Do not copy these secrets to KataBump. See BACKUPS.md before any real export.
# Optional backup-specific DIRECT PostgreSQL connection; otherwise uses DIRECT_DATABASE_URL / DATABASE_URL.
# BACKUP_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
BACKUP_ENCRYPTION_KEY=
# Signing-region default; change if your endpoint requires another value (e.g. auto).
S3_REGION=us-east-1
BACKUP_PREFIX=votebot/postgres/
BACKUP_USE_DOCKER=false
# Deleting old objects is separately opt-in. Manual runs count toward this limit.
BACKUP_PRUNE_ENABLED=false
BACKUP_KEEP_COUNT=7
# Existing object key for backup:verify, not a URL:
# BACKUP_VERIFY_KEY=votebot/postgres/backup-TIMESTAMP-UUID.pgdump.enc
