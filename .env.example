# Copy to .env for local development. Never commit real credentials.
# Existing process environment variables take precedence.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# Optional direct PostgreSQL endpoint for migrations (if DATABASE_URL is pooled):
# DIRECT_DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Tracking AND settlement are OFF by default. Keep disabled until member commands/reports ship.
REPUTATION_TRACKING_ENABLED=false
# Required when tracking is explicitly enabled; only this server will be tracked.
# REPUTATION_GUILD_ID=YOUR_DISCORD_SERVER_ID

# Bucket credentials are not used yet. Backup configuration comes later.
