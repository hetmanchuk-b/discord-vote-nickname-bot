generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "cjs"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

// Monetary Int fields are integer quarter-point units (4 units = 1 displayed
// point). Durations, counts and streaks are NOT scaled. *_units column names
// prevent legacy whole-point binaries from silently interpreting the new data.
// Stage 5: durable publication snapshots and reusable operational warnings.
model ReputationGuild {
  guildId         String   @id @map("guild_id") @db.VarChar(20)
  reportChannelId String?  @map("report_channel_id") @db.VarChar(20)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  trackingRunId      String?   @map("tracking_run_id") @db.Uuid
  settledThrough     DateTime? @map("settled_through") @db.Timestamptz(3)
  attendanceStartsAt DateTime? @map("attendance_starts_at") @db.Timestamptz(3)

  members      ReputationMember[]
  trackingRuns ReputationTrackingRun[]
  settlements  ReputationSettlement[]
  reports      ReputationReport[]
  warning      ReputationWarning?
  voicePolls   VoiceReputationPoll[]

  @@map("reputation_guilds")
}

model ReputationMember {
  guildId          String    @map("guild_id") @db.VarChar(20)
  userId           String    @map("user_id") @db.VarChar(20)
  isTracking       Boolean   @default(true) @map("is_tracking")
  trackingSince    DateTime? @map("tracking_since") @db.Timestamptz(3)
  balance          Int       @default(0) @map("balance_units")
  hasParticipated  Boolean   @default(false) @map("has_participated")
  attendanceStreak Int       @default(0) @map("attendance_streak")
  absenceStreak    Int       @default(0) @map("absence_streak")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  guild     ReputationGuild           @relation(fields: [guildId], references: [guildId], onDelete: Restrict)
  intervals ReputationVoiceInterval[]
  awards    ReputationDailyAward[]
  pauses    ReputationTrackingPause[]

  @@id([guildId, userId])
  @@map("reputation_members")
}

// Personal pause history is required for chronological settlement after downtime.
model ReputationTrackingPause {
  id        BigInt           @id @default(autoincrement())
  guildId   String           @map("guild_id") @db.VarChar(20)
  userId    String           @map("user_id") @db.VarChar(20)
  startedAt DateTime         @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?        @map("ended_at") @db.Timestamptz(3)
  member    ReputationMember @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade, map: "reputation_tracking_pauses_member_fkey")

  @@index([guildId, userId, startedAt])
  @@map("reputation_tracking_pauses")
}

// Coverage is [startedAt, verifiedThrough), NOT [startedAt, closedAt).
// A replacement process starts a new run; offline gaps never become voice time.
model ReputationTrackingRun {
  id              String    @id @db.Uuid
  guildId         String    @map("guild_id") @db.VarChar(20)
  startedAt       DateTime  @map("started_at") @db.Timestamptz(3)
  verifiedThrough DateTime  @map("verified_through") @db.Timestamptz(3)
  closedAt        DateTime? @map("closed_at") @db.Timestamptz(3)
  endReason       String?   @map("end_reason") @db.VarChar(32)

  guild     ReputationGuild           @relation(fields: [guildId], references: [guildId], onDelete: Restrict)
  intervals ReputationVoiceInterval[]

  @@index([guildId, startedAt])
  @@map("reputation_tracking_runs")
}

// Unrounded, half-open UTC intervals. Daily Kyiv boundaries are applied at settlement.
model ReputationVoiceInterval {
  id          BigInt   @id @default(autoincrement())
  guildId     String   @map("guild_id") @db.VarChar(20)
  userId      String   @map("user_id") @db.VarChar(20)
  runId       String   @map("run_id") @db.Uuid
  startedAt   DateTime @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime @map("ended_at") @db.Timestamptz(3)
  earningRate Int      @default(4) @map("earning_rate") @db.SmallInt

  member ReputationMember      @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  run    ReputationTrackingRun @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([guildId, endedAt, startedAt])
  @@index([guildId, userId, startedAt])
  @@map("reputation_voice_intervals")
}

// The unique day ledger survives deletion of member-level records. Never replay
// a settled day, even if its report has not been delivered or a member is erased.
model ReputationSettlement {
  guildId       String   @map("guild_id") @db.VarChar(20)
  day           String   @db.VarChar(10)
  startedAt     DateTime @map("started_at") @db.Timestamptz(3)
  endedAt       DateTime @map("ended_at") @db.Timestamptz(3)
  settledAt     DateTime @default(now()) @map("settled_at") @db.Timestamptz(3)
  verifiedMs    Int      @map("verified_ms")
  incomplete    Boolean
  activityMs    BigInt   @map("activity_ms")
  pointsAwarded Int      @map("points_awarded_units")

  guild  ReputationGuild        @relation(fields: [guildId], references: [guildId], onDelete: Restrict)
  awards ReputationDailyAward[]
  report ReputationReport?

  @@id([guildId, day])
  @@map("reputation_settlements")
}

// Live daily results, including bonuses, absence penalties and exemptions.
// points is the ACTUAL balance delta after clamping; components are uncapped.
// Historical published
// report snapshots will be separate so member deletion can keep published history.
model ReputationDailyAward {
  guildId          String  @map("guild_id") @db.VarChar(20)
  userId           String  @map("user_id") @db.VarChar(20)
  day              String  @db.VarChar(10)
  eligibleMs       Int     @map("eligible_ms")
  soloMs           Int     @default(0) @map("solo_ms")
  points           Int     @map("points_units")
  balanceAfter     Int     @map("balance_after_units")
  basePoints       Int     @default(0) @map("base_points_units")
  attendanceBonus  Int     @default(0) @map("attendance_bonus_units")
  absencePenalty   Int     @default(0) @map("absence_penalty_units")
  attendanceStreak Int     @default(0) @map("attendance_streak")
  absenceStreak    Int     @default(0) @map("absence_streak")
  exempt           Boolean @default(false)

  member     ReputationMember     @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)
  settlement ReputationSettlement @relation(fields: [guildId, day], references: [guildId, day], onDelete: Restrict)

  @@id([guildId, userId, day])
  @@index([guildId, day, points, eligibleMs, userId], map: "reputation_daily_awards_ranking_idx")
  @@map("reputation_daily_awards")
}

enum ReputationReportStatus {
  pending
  publishing
  published
  missing
}

model ReputationReport {
  id            String                 @id @db.Uuid
  guildId       String                 @map("guild_id") @db.VarChar(20)
  day           String                 @db.VarChar(10)
  status        ReputationReportStatus @default(pending)
  channelId     String?                @map("channel_id") @db.VarChar(20)
  messageId     String?                @unique @map("message_id") @db.VarChar(20)
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  preparedAt    DateTime?              @map("prepared_at") @db.Timestamptz(3)
  lastAttemptAt DateTime?              @map("last_attempt_at") @db.Timestamptz(3)
  publishedAt   DateTime?              @map("published_at") @db.Timestamptz(3)
  activityMs    BigInt                 @default(0) @map("activity_ms")
  pointsAwarded Int                    @default(0) @map("points_awarded_units")
  entryCount    Int                    @default(0) @map("entry_count")

  guild      ReputationGuild         @relation(fields: [guildId], references: [guildId], onDelete: Restrict)
  settlement ReputationSettlement    @relation(fields: [guildId, day], references: [guildId, day], onDelete: Restrict)
  entries    ReputationReportEntry[]

  @@unique([guildId, day])
  @@index([guildId, status, day])
  @@map("reputation_reports")
}

// Intentionally NOT linked to ReputationMember: published history survives erasure.
model ReputationReportEntry {
  reportId     String @map("report_id") @db.Uuid
  guildId      String @map("guild_id") @db.VarChar(20)
  userId       String @map("user_id") @db.VarChar(20)
  position     Int
  eligibleMs   Int    @map("eligible_ms")
  points       Int    @map("points_units")
  balanceAfter Int    @map("balance_after_units")

  report ReputationReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@id([reportId, position])
  @@unique([reportId, userId])
  @@index([guildId, userId])
  @@map("reputation_report_entries")
}

model ReputationWarning {
  guildId           String    @id @map("guild_id") @db.VarChar(20)
  channelId         String?   @map("channel_id") @db.VarChar(20)
  messageId         String?   @map("message_id") @db.VarChar(20)
  reasons           String[]  @default([])
  history           Json      @default("[]")
  activeSince       DateTime? @map("active_since") @db.Timestamptz(3)
  lastSeenAt        DateTime  @map("last_seen_at") @db.Timestamptz(3)
  lastEditedAt      DateTime? @map("last_edited_at") @db.Timestamptz(3)
  displayedActive   Boolean   @default(false) @map("displayed_active")
  deliveryUncertain Boolean   @default(false) @map("delivery_uncertain")

  guild ReputationGuild @relation(fields: [guildId], references: [guildId], onDelete: Restrict)

  @@map("reputation_warnings")
}

// Polls are durable financial/history records, intentionally not member-owned.
model VoiceReputationPoll {
  id             String                @id @db.Uuid
  guildId        String                @map("guild_id") @db.VarChar(20)
  targetId       String                @map("target_id") @db.VarChar(20)
  initiatorId    String                @map("initiator_id") @db.VarChar(20)
  voiceChannelId String                @map("voice_channel_id") @db.VarChar(20)
  textChannelId  String                @map("text_channel_id") @db.VarChar(20)
  messageId      String?               @unique @map("message_id") @db.VarChar(20)
  amount         Int                   @map("amount_units")
  kind           String                @default("penalty") @db.VarChar(8)
  status         String                @default("creating") @db.VarChar(16)
  reason         String?               @db.VarChar(32)
  proposalReason String?               @map("proposal_reason") @db.VarChar(1000)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt      DateTime?             @map("started_at") @db.Timestamptz(3)
  endsAt         DateTime?             @map("ends_at") @db.Timestamptz(3)
  closedAt       DateTime?             @map("closed_at") @db.Timestamptz(3)
  appliedAmount  Int                   @default(0) @map("applied_amount_units")
  balanceAfter   Int?                  @map("balance_after_units")
  balanceBefore  Int?                  @map("balance_before_units")
  noVoterIds     String[]              @default([]) @map("no_voter_ids")
  publishing     Boolean               @default(false)
  publishedAt    DateTime?             @map("published_at") @db.Timestamptz(3)
  messageMissing Boolean               @default(false) @map("message_missing")
  lastAttemptAt  DateTime?             @map("last_attempt_at") @db.Timestamptz(3)
  guild          ReputationGuild       @relation(fields: [guildId], references: [guildId], onDelete: Restrict)
  votes          VoiceReputationVote[]

  @@index([guildId, status, endsAt])
  @@index([guildId, publishedAt, lastAttemptAt], map: "voice_reputation_polls_publication_retry_idx")
  @@map("voice_reputation_polls")
}

model VoiceReputationVote {
  pollId        String              @map("poll_id") @db.Uuid
  userId        String              @map("user_id") @db.VarChar(20)
  yes           Boolean
  interactionId String              @default("0") @map("interaction_id") @db.VarChar(20)
  updatedAt     DateTime            @default(now()) @map("updated_at") @db.Timestamptz(3)
  poll          VoiceReputationPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@id([pollId, userId])
  @@index([userId, pollId])
  @@map("voice_reputation_votes")
}
